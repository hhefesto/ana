@@# Agda behaviour tasks, checked with Agda 2.8.0 and standard-library-2.3: behaviour run writes
@@# Task.agda as `{-# OPTIONS --safe #-}`, the module header and the shared imports (in
@@# bend/CorpusV2/Behaviour.bend), the pre, the Type, the answer (a line equal to the Type is dropped), then the
@@# tests.  A `type` task's tests are `_ : f x ≡ y` / `_ = refl` pairs (checked by
@@# normalisation); a `proposition` task has none: type-checking the proof is the test.
@@# Format: see ../README.txt.

@@ task double type
@@ user
Twice a natural number.
@@ type
double : ℕ → ℕ
@@ tests
_ : double 0 ≡ 0
_ = refl
_ : double 3 ≡ 6
_ = refl
_ : double 21 ≡ 42
_ = refl
@@ ref
double zero = zero
double (suc n) = suc (suc (double n))

@@ task fact type
@@ user
The factorial of a natural number.
@@ type
fact : ℕ → ℕ
@@ tests
_ : fact 0 ≡ 1
_ = refl
_ : fact 1 ≡ 1
_ = refl
_ : fact 5 ≡ 120
_ = refl
@@ ref
fact zero = 1
fact (suc n) = suc n * fact n

@@ task fib type
@@ user
The n-th Fibonacci number, with fib 0 = 0 and fib 1 = 1.
@@ type
fib : ℕ → ℕ
@@ tests
_ : fib 0 ≡ 0
_ = refl
_ : fib 1 ≡ 1
_ = refl
_ : fib 2 ≡ 1
_ = refl
_ : fib 10 ≡ 55
_ = refl
@@ ref
fib zero = zero
fib (suc zero) = suc zero
fib (suc (suc n)) = fib n + fib (suc n)

@@ task sumList type
@@ user
The sum of a list of natural numbers.
@@ type
sumList : List ℕ → ℕ
@@ tests
_ : sumList [] ≡ 0
_ = refl
_ : sumList (1 ∷ 2 ∷ 3 ∷ []) ≡ 6
_ = refl
_ : sumList (10 ∷ []) ≡ 10
_ = refl
@@ ref
sumList [] = 0
sumList (x ∷ xs) = x + sumList xs

@@ task rev type
@@ user
Reverse a list.
@@ type
rev : {A : Set} → List A → List A
@@ tests
_ : rev (1 ∷ 2 ∷ 3 ∷ []) ≡ 3 ∷ 2 ∷ 1 ∷ []
_ = refl
_ : rev {A = ℕ} [] ≡ []
_ = refl
_ : rev (true ∷ false ∷ []) ≡ false ∷ true ∷ []
_ = refl
@@ ref
rev [] = []
rev (x ∷ xs) = rev xs ++ (x ∷ [])

@@ task isEven type
@@ user
Whether a natural number is even.
@@ type
isEven : ℕ → Bool
@@ tests
_ : isEven 0 ≡ true
_ = refl
_ : isEven 1 ≡ false
_ = refl
_ : isEven 7 ≡ false
_ = refl
_ : isEven 10 ≡ true
_ = refl
@@ ref
isEven zero = true
isEven (suc zero) = false
isEven (suc (suc n)) = isEven n

@@ task maxList type
@@ user
The largest element of a list of natural numbers, or 0 for the empty list.
@@ type
maxList : List ℕ → ℕ
@@ tests
_ : maxList (3 ∷ 1 ∷ 4 ∷ 1 ∷ 5 ∷ []) ≡ 5
_ = refl
_ : maxList [] ≡ 0
_ = refl
_ : maxList (2 ∷ 9 ∷ 9 ∷ 1 ∷ []) ≡ 9
_ = refl
_ : maxList (7 ∷ []) ≡ 7
_ = refl
@@ ref
maxList [] = 0
maxList (x ∷ xs) = x ⊔ maxList xs

@@ task countTrue type
@@ user
The number of true values in a list of booleans.
@@ type
countTrue : List Bool → ℕ
@@ tests
_ : countTrue (true ∷ false ∷ true ∷ []) ≡ 2
_ = refl
_ : countTrue [] ≡ 0
_ = refl
_ : countTrue (false ∷ []) ≡ 0
_ = refl
@@ ref
countTrue [] = 0
countTrue (true ∷ bs) = suc (countTrue bs)
countTrue (false ∷ bs) = countTrue bs

@@ task power type
@@ user
power b e is b raised to the power e, by repeated multiplication.
@@ type
power : ℕ → ℕ → ℕ
@@ tests
_ : power 2 10 ≡ 1024
_ = refl
_ : power 5 0 ≡ 1
_ = refl
_ : power 0 3 ≡ 0
_ = refl
_ : power 3 4 ≡ 81
_ = refl
@@ ref
power b zero = 1
power b (suc e) = b * power b e

@@ task copies type
@@ user
A list holding n copies of an element.
@@ type
copies : {A : Set} → ℕ → A → List A
@@ tests
_ : copies 3 true ≡ true ∷ true ∷ true ∷ []
_ = refl
_ : copies 0 5 ≡ []
_ = refl
_ : copies 1 7 ≡ 7 ∷ []
_ = refl
@@ ref
copies zero x = []
copies (suc n) x = x ∷ copies n x

@@ task lastOr type
@@ user
The last element of a list, or the given default when the list is empty.
@@ type
lastOr : ℕ → List ℕ → ℕ
@@ tests
_ : lastOr 0 (1 ∷ 2 ∷ 3 ∷ []) ≡ 3
_ = refl
_ : lastOr 7 [] ≡ 7
_ = refl
_ : lastOr 0 (5 ∷ []) ≡ 5
_ = refl
@@ ref
lastOr d [] = d
lastOr d (x ∷ []) = x
lastOr d (x ∷ y ∷ ys) = lastOr d (y ∷ ys)

@@ task headMaybe type
@@ user
The first element of a list, if there is one.
@@ type
headMaybe : {A : Set} → List A → Maybe A
@@ tests
_ : headMaybe (1 ∷ 2 ∷ []) ≡ just 1
_ = refl
_ : headMaybe {A = ℕ} [] ≡ nothing
_ = refl
_ : headMaybe (false ∷ []) ≡ just false
_ = refl
@@ ref
headMaybe [] = nothing
headMaybe (x ∷ xs) = just x

@@ task countOcc type
@@ user
How many times a number occurs in a list.
@@ context
_≡ᵇ_ : ℕ → ℕ → Bool
@@ type
countOcc : ℕ → List ℕ → ℕ
@@ tests
_ : countOcc 1 (1 ∷ 2 ∷ 1 ∷ 1 ∷ []) ≡ 3
_ = refl
_ : countOcc 5 [] ≡ 0
_ = refl
_ : countOcc 2 (1 ∷ 3 ∷ []) ≡ 0
_ = refl
@@ ref
countOcc x [] = 0
countOcc x (y ∷ ys) = if x ≡ᵇ y then suc (countOcc x ys) else countOcc x ys

@@ task insertSorted type
@@ user
Insert a number into a sorted list of natural numbers, keeping it sorted.
@@ context
_≤ᵇ_ : ℕ → ℕ → Bool
@@ type
insertSorted : ℕ → List ℕ → List ℕ
@@ tests
_ : insertSorted 3 (1 ∷ 2 ∷ 4 ∷ 5 ∷ []) ≡ 1 ∷ 2 ∷ 3 ∷ 4 ∷ 5 ∷ []
_ = refl
_ : insertSorted 0 [] ≡ 0 ∷ []
_ = refl
_ : insertSorted 9 (1 ∷ 2 ∷ []) ≡ 1 ∷ 2 ∷ 9 ∷ []
_ = refl
_ : insertSorted 1 (2 ∷ 3 ∷ []) ≡ 1 ∷ 2 ∷ 3 ∷ []
_ = refl
@@ ref
insertSorted x [] = x ∷ []
insertSorted x (y ∷ ys) = if x ≤ᵇ y then x ∷ y ∷ ys else y ∷ insertSorted x ys

@@ task everyOther type
@@ user
The elements at even positions (0, 2, 4, ...) of a list.
@@ type
everyOther : List ℕ → List ℕ
@@ tests
_ : everyOther (1 ∷ 2 ∷ 3 ∷ 4 ∷ 5 ∷ []) ≡ 1 ∷ 3 ∷ 5 ∷ []
_ = refl
_ : everyOther [] ≡ []
_ = refl
_ : everyOther (7 ∷ []) ≡ 7 ∷ []
_ = refl
_ : everyOther (1 ∷ 2 ∷ []) ≡ 1 ∷ []
_ = refl
_ : everyOther (2 ∷ 4 ∷ 6 ∷ []) ≡ 2 ∷ 6 ∷ []
_ = refl
@@ ref
everyOther [] = []
everyOther (x ∷ []) = x ∷ []
everyOther (x ∷ y ∷ rest) = x ∷ everyOther rest

@@ task plus-zero proposition
@@ user
Prove `plus-zero`.
@@ type
plus-zero : ∀ (n : ℕ) → n + 0 ≡ n
@@ ref
plus-zero zero = refl
plus-zero (suc n) = cong suc (plus-zero n)

@@ task plus-suc proposition
@@ user
Prove `plus-suc`.
@@ type
plus-suc : ∀ (m n : ℕ) → m + suc n ≡ suc (m + n)
@@ ref
plus-suc zero n = refl
plus-suc (suc m) n = cong suc (plus-suc m n)

@@ task not-not proposition
@@ user
Prove `not-not`.
@@ type
not-not : ∀ (b : Bool) → not (not b) ≡ b
@@ ref
not-not true = refl
not-not false = refl

@@ task map-id proposition
@@ user
Prove `map-id`.
@@ type
map-id : ∀ {A : Set} (xs : List A) → map (λ x → x) xs ≡ xs
@@ ref
map-id [] = refl
map-id (x ∷ xs) = cong (x ∷_) (map-id xs)

@@ task length-append proposition
@@ user
Prove `length-append`.
@@ type
length-append : ∀ {A : Set} (xs ys : List A) → length (xs ++ ys) ≡ length xs + length ys
@@ ref
length-append [] ys = refl
length-append (x ∷ xs) ys = cong suc (length-append xs ys)

@@ task twice-sum proposition
@@ user
Prove `twice-sum`.
@@ context
twice : ℕ → ℕ
+-suc : ∀ m n → m + suc n ≡ suc (m + n)
@@ type
twice-sum : ∀ (n : ℕ) → twice n ≡ n + n
@@ pre
open import Data.Nat.Properties using (+-suc)

twice : ℕ → ℕ
twice zero = zero
twice (suc n) = suc (suc (twice n))
@@ ref
twice-sum zero = refl
twice-sum (suc n) = cong suc (trans (cong suc (twice-sum n)) (sym (+-suc n n)))
