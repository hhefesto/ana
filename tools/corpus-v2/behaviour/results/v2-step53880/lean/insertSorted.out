theorem thm_24097 :
  let f := fun x => x ^ 2 + x + 1;
  let g := fun x => x ^ 2 + x + 1;
  let h := fun x => x ^ 2 + x + 1;
  let x := f g;
  x = 1 ∧ g = 1 ∧ h = 1 ∧ x = 1 ∧ x = 1 ∧ x = 1 ∧ x = 1 ∧ x = 1 ∧ x = 1 ∧ x = 1 ∧ x = 1 ∧ x = 1 ∧ x
