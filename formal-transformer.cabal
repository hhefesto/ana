cabal-version:      2.4
name:               formal-transformer
version:            0.1.0.0
synopsis:           Compact reference runtime for a canonical decoder transformer
description:        A CPU reference implementation, language semantics, optimizer, artifacts, and tests for a flat-parameter decoder transformer.
license:             MIT
build-type:         Simple

common common-settings
  default-language: Haskell2010
  ghc-options:      -Wall -Wcompat
  build-depends:    base >=4.14 && <5

library
  import:           common-settings
  hs-source-dirs:   backend/src
  exposed-modules:
      FormalTransformer.AD
      FormalTransformer.Artifact
      FormalTransformer.Attention.Gla
      FormalTransformer.Bigram
      FormalTransformer.Config
      FormalTransformer.Data
      FormalTransformer.Language
      FormalTransformer.Language.Autoregressive
      FormalTransformer.Layout
      FormalTransformer.Model
      FormalTransformer.Optimizer
      FormalTransformer.Semiring
      FormalTransformer.Tokenizer
  build-depends:
      ad >=4.5 && <5,
      binary >=0.8 && <0.9,
      bytestring >=0.10 && <0.13,
      containers >=0.6 && <0.8,
      cryptohash-sha256 >=0.11 && <0.12,
      directory >=1.3 && <1.4,
      filepath >=1.4 && <1.6,
      parallel >=3.2 && <3.3,
      unix >=2.7 && <2.9,
      vector >=0.12 && <0.14

executable formal-transformer
  import:           common-settings
  hs-source-dirs:   backend/app
  main-is:          Main.hs
  -- Corpus preparation encodes documents in parallel (see encodeDocuments);
  -- without -threaded and -N the sparks all run on one capability.
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
      formal-transformer,
      bytestring >=0.10 && <0.13,
      containers >=0.6 && <0.8,
      directory >=1.3 && <1.4,
      parallel >=3.2 && <3.3,
      vector >=0.12 && <0.14

test-suite formal-transformer-test
  import:           common-settings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   backend/test
  main-is:          Main.hs
  build-depends:
      formal-transformer,
      bytestring >=0.10 && <0.13,
      directory >=1.3 && <1.4,
      filepath >=1.4 && <1.6,
      vector >=0.12 && <0.14
