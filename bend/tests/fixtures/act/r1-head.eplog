```haskell
CSS
  :: SStack
     -> SymbolTable -> [CompileLog] -> Integer -> CollectSymbolState
stack :: CollectSymbolState -> SStack
popCurrentLevel :: Integer -> SStack -> SStack
stable :: CollectSymbolState -> SymbolTable
