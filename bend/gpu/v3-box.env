# bend-push's settings for run 3 (TRAIN_ENV_FILE; docs/AGENT.md): S1, corpus v2's steady mix
# (run/v3/S1: run 2's format-2 transcript windows, the synthetic chains and the steady raw
# slices), its plan and shards in the plan's order, to REMOTE_DIR on the box. S2 is built on
# the box at S1's boundary (tools/corpus-v2/s2.sh).
RUN_DIR=run/v3/S1
SIZE=fp100m
TRAIN_BATCH=16
PLAN=run/v3/S1/plan-fp100m-b16-windows.tsv
TOKENIZER_FILE=weights/code32k.bpe
REMOTE_DIR=formalTransformer
