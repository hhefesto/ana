# bend-push's settings for run 4 (TRAIN_ENV_FILE; `BOX_ENV=bend/gpu/v4-box.env bend-ops stage
# box HOST PORT`): C1, run/v4/R4 (the raw no earlier run saw, steady-mixed with a small replay,
# and a second pass over run 3's transcript windows at share 0.15; tools/runs/run4-build.txt),
# its plan and shards in the plan's order, to REMOTE_DIR on the box.  C1 hot-starts from run 3's
# final checkpoint (`bend-box again`, tools/runs/run4.cfg); C2 and CTL are built on the box at
# C1's boundary by bend-corpus-v2 s2.
RUN_DIR=run/v4/R4
SIZE=fp100m
TRAIN_BATCH=16
PLAN=run/v4/R4/plan-fp100m-b16-windows.tsv
TOKENIZER_FILE=weights/code32k.bpe
REMOTE_DIR=formalTransformer
