# bend-push's settings for the fp100m corpus (TRAIN_ENV_FILE): the windows
# plan and its 36 shards, in the plan's order, to REMOTE_DIR on the box.
RUN_DIR=run/fp100m
SIZE=fp100m
TRAIN_BATCH=16
PLAN=run/fp100m/plan-fp100m-b16-windows.tsv
TOKENIZER_FILE=weights/code32k.bpe
REMOTE_DIR=formalTransformer
