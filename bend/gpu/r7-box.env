# bend-push's settings for run 7 on R7 (run/v9/run7.sh, docs/r7/PLAN.md).  As r6-box.env;
# BOX_ENV=bend/gpu/r7-box.env bend-ops stage box HOST PORT (run/v9/run7go.sh does it, after the user's approval).
# R7's fixed validation set (run/v9/R7valid/shard-0-fp100m.corpus) is not a shard: run7go.sh copies it to the box
# itself and gives it to the trainer as VALID_CORPUS.
RUN_DIR=run/v9/R7
SIZE=fp100m
TRAIN_BATCH=16
PLAN=run/v9/R7/plan-fp100m-b16-windows.tsv
TOKENIZER_FILE=weights/code32k.bpe
REMOTE_DIR=ana
