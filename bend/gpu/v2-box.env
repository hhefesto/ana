# bend-push's settings for run 2 (TRAIN_ENV_FILE; docs/CORPUS-V2.md, docs/AGENT.md): corpus v2's one
# mix (run/v2/mixall: the transcript windows without verify and every raw slice), its plan and
# shards in the plan's order, to REMOTE_DIR on the box.
RUN_DIR=run/v2/mixall
SIZE=fp100m
TRAIN_BATCH=16
PLAN=run/v2/mixall/plan-fp100m-b16-windows.tsv
TOKENIZER_FILE=weights/code32k.bpe
REMOTE_DIR=formalTransformer
