# bend-push's settings for run 5 (TRAIN_ENV_FILE; `BOX_ENV=bend/gpu/v5-box.env bend-ops stage box
# HOST PORT`): run/v6/R5, every language's sessions in the mugen shape (docs/MUGEN-SHAPE.md,
# tools/runs/run5-build.txt), its plan and shards in the plan's order, to REMOTE_DIR on the box.
# The run hot-starts from run 4's c2-step72491 (`bend-box again`, tools/runs/RUN5.md).
RUN_DIR=run/v6/R5
SIZE=fp100m
TRAIN_BATCH=16
PLAN=run/v6/R5/plan-fp100m-b16-windows.tsv
TOKENIZER_FILE=weights/code32k.bpe
REMOTE_DIR=ana
