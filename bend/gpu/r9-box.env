# bend-push's settings for run 9 on R9 (run/v9/run9.sh, docs/r9/PLAN.md section 4).  As r8-box.env;
# BOX_ENV=bend/gpu/r9-box.env bend-ops stage box HOST PORT (run/v9/run9go.sh does it, after the user's approval).
# R8's fixed validation set (run/v9/R8valid/shard-0-fp100m.corpus) is not a shard: run9go.sh copies it to the box
# itself and gives it to the trainer as VALID_CORPUS.
RUN_DIR=run/v9/R9
SIZE=fp100m
TRAIN_BATCH=16
PLAN=run/v9/R9/plan-fp100m-b16-windows.tsv
TOKENIZER_FILE=weights/code32k.bpe
REMOTE_DIR=ana
