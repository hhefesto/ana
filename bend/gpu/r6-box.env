# bend-push's settings for run 6 on R6: R5g's plan with form 2's kinds (run/v9/run6.sh, docs/form2/KINDS.md). As
# r5g-box.env; BOX_ENV=bend/gpu/r6-box.env bend-ops stage box HOST PORT (run/v9/run6go.sh does it).
RUN_DIR=run/v9/R6
SIZE=fp100m
TRAIN_BATCH=16
PLAN=run/v9/R6/plan-fp100m-b16-windows.tsv
TOKENIZER_FILE=weights/code32k.bpe
REMOTE_DIR=ana
