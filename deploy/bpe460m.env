# bpe460m.env — the run-defining settings for the v4 run (docs/V4-DESIGN.md).
#
# Sourced by deploy/train-cloud-diloco.sh, which launches one process per GPU:
#
#   TRAIN_ENV_FILE=deploy/bpe460m.env deploy/train-cloud-diloco.sh
#
# Every assignment is `: "${VAR:=...}"` plus an explicit export, so a value
# given on the command line still wins. Paths are relative to the repo root.
#
# Nothing here is warm-started. Both the tokenizer and the context changed, so
# there is no earlier checkpoint whose parameters mean the same thing.

# --- Corpus and plan ------------------------------------------------------
: "${SIZE:=bpe460m}"
: "${RUN_DIR:=run/packed-a-bpe460m}"
# 2,000 rather than 32,000: at a 128 KB pack target that keeps a shard near the
# ~272 MB of text the v2 run proved safe to plan in RAM. Packing multiplies the
# bytes behind each document by roughly 35x, so the old count would not fit.
: "${SHARD_ARTICLES:=2000}"
: "${TOKENIZER_FILE:=run/code32k.bpe}"
: "${CHECKPOINT:=run/wiki-bpe460m-global.checkpoint}"
export SIZE RUN_DIR SHARD_ARTICLES TOKENIZER_FILE CHECKPOINT

# --- Shape ----------------------------------------------------------------
# TRAIN_BATCH is semantic: it enters the plan identity and sets the schedule,
# so it cannot change once the corpus is planned. It is GLOBAL -- each of the
# two ranks computes half of it. MICRO_BATCH is free.
#
# BOTH VALUES COME FROM THE MILESTONE 1 SWEEP AND ARE PROVISIONAL UNTIL THEN.
# Fixed device cost at 463M under Muon is ~17.4 GB, and activations at context
# 1024 are estimated at 500-900 MiB/sample, which puts the usable micro-batch
# somewhere between 6 and 29 -- too wide a range to commit a 10-day run to.
: "${TRAIN_BATCH:=64}"
: "${MICRO_BATCH:=8}"
export TRAIN_BATCH MICRO_BATCH

# --- Optimizer and trainer ------------------------------------------------
# GEMM_NUMERICS enters the checkpoint manifest and cannot change mid-run.
: "${TRAIN_OPT:=muon}"
: "${GEMM_NUMERICS:=tf32}"
: "${GEMM_ORDERING:=stream}"
: "${TRAINER:=result-gemm/bin/formal-transformer-gemm-cuda}"
export TRAIN_OPT GEMM_NUMERICS GEMM_ORDERING TRAINER

# --- DiLoCo ---------------------------------------------------------------
# Two ranks averaging parameters every H inner steps, with an outer Nesterov
# step on the pseudo-gradient. CHECKPOINT_EVERY and VALIDATE_EVERY must stay
# multiples of DILOCO_H so a checkpoint never lands mid-window.
: "${DILOCO_WORLD:=2}"
: "${DILOCO_H:=30}"
: "${DILOCO_OUTER_LR:=0.7}"
: "${DILOCO_MOMENTUM:=0.9}"
: "${DILOCO_DIR:=/dev/shm/ana-diloco}"
: "${DILOCO_TIMEOUT:=1800}"
export DILOCO_WORLD DILOCO_H DILOCO_OUTER_LR DILOCO_MOMENTUM DILOCO_DIR DILOCO_TIMEOUT

# --- Execution ------------------------------------------------------------
# PERSISTENT is REQUIRED, not a preference: the shard-boundary barrier that
# keeps the two ranks from racing on the checkpoint file lives inside
# train-plan's loop, and a per-shard relaunch would skip it entirely.
: "${PERSISTENT:=1}"
export PERSISTENT
