# bpe100m-v3.env — the run-defining settings for the warm-started v3 run
# (docs/V3-DECISIONS.md section 6).
#
# Sourced exactly like deploy/bpe100m.env:
#
#   TRAIN_ENV_FILE=deploy/bpe100m-v3.env deploy/train-cloud.sh
#
# Same data, same plan, new model.  The plan is architecture-agnostic (its
# header only names the data), so the v2 run's plan file is reused verbatim
# via an explicit PLAN — but the corpus filenames embed SIZE, so the box
# needs one-time symlinks before the first launch:
#
#   for f in run/mixed-bpe100m-s32000/shard-*-bpe100m.corpus; do
#     ln -sfn "$(basename "$f")" "${f%-bpe100m.corpus}-bpe100m-v3.corpus"
#   done
#
# Every assignment is `: "${VAR:=...}"` plus an explicit export, so a value
# given on the command line still wins.  Paths are relative to the repo root.

# --- Corpus and plan ------------------------------------------------------
: "${SIZE:=bpe100m-v3}"
: "${RUN_DIR:=run/mixed-bpe100m-s32000}"
: "${SHARD_ARTICLES:=32000}"
: "${TOKENIZER_FILE:=run/enwiki-fineweb-32k.bpe}"
# The v2 plan, by its real name: train-cloud.sh would otherwise derive
# plan-bpe100m-v3-b64-s32000.tsv, which does not exist.
: "${PLAN:=run/mixed-bpe100m-s32000/plan-bpe100m-b64-s32000.tsv}"
# A NEW checkpoint path: TRAIN_INIT only fires when the checkpoint does not
# exist yet, and the v2 checkpoint must survive as the warm-start source.
: "${CHECKPOINT:=run/wiki-bpe100m-v3-global.checkpoint}"
export SIZE RUN_DIR SHARD_ARTICLES TOKENIZER_FILE PLAN CHECKPOINT

# --- The v3 run definition ------------------------------------------------
# Warm start from the v2 master-run checkpoint (V3-DECISIONS section 5):
# every matrix transfers except the nine GLA walpha projections (gate kind
# changed); gate_lambda / qk gains / sinks start fresh.  Applies only to the
# very first launch; once the v3 checkpoint exists, resume ignores this.
: "${TRAIN_INIT:=run/wiki-bpe100m-global.checkpoint}"
# Muon on the hidden matrices, AdamW on the embedding (adopted in section 6
# without its A3 pilot — recorded there as a protocol deviation).
: "${TRAIN_OPT:=muon}"
export TRAIN_INIT TRAIN_OPT

# --- Shape ----------------------------------------------------------------
# TRAIN_BATCH is semantic (it enters the plan identity) and must stay 64.
# MICRO_BATCH is free; 64 was the best of the GEMM sweep at 22.4 GB peak.
: "${TRAIN_BATCH:=64}"
: "${MICRO_BATCH:=64}"
export TRAIN_BATCH MICRO_BATCH

# --- Trainer --------------------------------------------------------------
# The decomposed GEMM trainer, which carries the v3 arms and the Muon step
# since the 2026-08-20 port (verified element-wise against the fused
# oracle and Numeric.AD in gemm-conformance).  The first launch attempt
# used the plain Futhark CUDA backend and measured ~200 tok/s at bpe100m
# on the 3090 — ~340 days for the plan — which is why the port exists.
# GEMM_NUMERICS enters the checkpoint manifest and cannot change mid-run.
: "${GEMM_NUMERICS:=tf32}"
: "${GEMM_ORDERING:=stream}"
: "${TRAINER:=result-gemm/bin/formal-transformer-gemm-cuda}"
export GEMM_NUMERICS GEMM_ORDERING TRAINER

# --- Execution ------------------------------------------------------------
# One process and one CUDA context for the whole plan, as in bpe100m.env.
: "${PERSISTENT:=1}"
export PERSISTENT
