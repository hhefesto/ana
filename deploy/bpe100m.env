# bpe100m.env — the run-defining settings for the 115M production run.
#
# Sourced by deploy/train-cloud.sh, deploy/push-corpus.sh and
# deploy/start-cloud-training.sh via TRAIN_ENV_FILE:
#
#   TRAIN_ENV_FILE=deploy/bpe100m.env deploy/train-cloud.sh
#
# It lives in deploy/ rather than run/ because .gitignore excludes /run/
# wholesale, so run/train-cloud.env can never be tracked, never reaches the box
# with the source tree, and is invisible to every Nix derivation.
#
# WHY A FILE AND NOT SHELL HISTORY.  GEMM_NUMERICS is recorded in the checkpoint
# manifest and `validateResume` rejects a mismatch, so it is chosen once for the
# whole 4.66-day run and cannot be changed partway.  Left unset,
# backend/gemm/GemmKernels.hs:131 silently defaults to Fp32IEEE -- while the
# measured 14,576 tok/s / 4.66 d / $54.76 baseline in run/sweep-5090 is tf32.
# Forgetting it does not fail; it just costs a slower run that can never be
# compared against the sweep.
#
# Every assignment is `: "${VAR:=...}"` followed by an explicit export, so a
# value given on the command line still wins:
#
#   MAX_SHARDS=4 TRAIN_ENV_FILE=deploy/bpe100m.env deploy/train-cloud.sh
#
# Paths are relative to the repository root; every consumer cds there first.

# --- Corpus and plan ------------------------------------------------------
# 304 shards / 358,276 steps.  SHARD_ARTICLES is load-bearing: train-cloud.sh
# builds PLAN as plan-$SIZE-b$BATCH-s$SHARD_ARTICLES.tsv, so the default of
# 4000 resolves to a file that does not exist.
: "${SIZE:=bpe100m}"
: "${RUN_DIR:=run/mixed-bpe100m-s32000}"
: "${SHARD_ARTICLES:=32000}"
: "${TOKENIZER_FILE:=run/enwiki-fineweb-32k.bpe}"
: "${CHECKPOINT:=run/wiki-bpe100m-global.checkpoint}"
export SIZE RUN_DIR SHARD_ARTICLES TOKENIZER_FILE CHECKPOINT

# --- Shape ----------------------------------------------------------------
# TRAIN_BATCH is *semantic* -- it enters the plan identity, so it must match the
# plan (b64) and cannot be tuned.  MICRO_BATCH is free, and 64 was the best of
# the sweep at 22.4 GB peak: 14,364 tok/s base, 14,576 with stream ordering.
: "${TRAIN_BATCH:=64}"
: "${MICRO_BATCH:=64}"
export TRAIN_BATCH MICRO_BATCH

# --- GEMM backend ---------------------------------------------------------
# tf32 -> CUBLAS_COMPUTE_32F_FAST_TF32.  bf16 measured no faster and fp32 is
# the slow path; see docs/RUN-2026-07-25-WIKI-FULL.md:470-480.
: "${GEMM_NUMERICS:=tf32}"
# stream ordering enqueues cuBLAS on the legacy default stream: 14,364 ->
# 14,576 tok/s, the best row in run/sweep-5090/sweep-production.tsv.
: "${GEMM_ORDERING:=stream}"
# The cuBLAS trainer, built by `BUILD_GEMM_CUDA=1 ./deploy/cloud-init.sh`.
# Without this, train-cloud.sh falls back to result/bin/formal-transformer-cuda,
# which is a different trainer and ignores GEMM_NUMERICS entirely.
: "${TRAINER:=result-gemm/bin/formal-transformer-gemm-cuda}"
export GEMM_NUMERICS GEMM_ORDERING TRAINER

# --- Execution ------------------------------------------------------------
# One process and one CUDA context for the whole plan.  Per-shard processes pay
# 5.15 s of context creation each -- ~26 min of paid GPU time over 304 shards --
# plus a kernel-cache load and a 1.385 GB checkpoint round trip.  Resume is by
# the checkpoint's own Adam step, so this stays interchangeable with the
# per-shard loop; deploy/train-plan-gate.sh proves the two agree byte for byte.
: "${PERSISTENT:=1}"
export PERSISTENT
